# Local development defaults for the Sylius test application.
#
# CI overrides DATABASE_URL (see .github/workflows/ci.yaml), so these values only apply to
# local runs. Port 3307 is used - not 3306 - so the plugin's MySQL container (see compose.yml)
# does not clash with a MySQL already installed on the host. Override anything here in
# tests/TestApplication/.env.local, which is git-ignored.
DATABASE_URL=mysql://root@127.0.0.1:3307/madcoders_sylius_gift_card_plugin_%kernel.environment%

BEHAT_BASE_URL="http://127.0.0.1:8080/"

SYLIUS_TEST_APP_BUNDLES_PATH="tests/TestApplication/config/bundles.php"
SYLIUS_TEST_APP_CONFIGS_TO_IMPORT="@MadcodersSyliusGiftCardPlugin/tests/TestApplication/config/config.yaml"
SYLIUS_TEST_APP_ROUTES_TO_IMPORT="@MadcodersSyliusGiftCardPlugin/tests/TestApplication/config/routes.yaml"

# Mail goes to the mailpit container from compose.yml, not into a null sink. The plugin delivers a
# gift card's code by email, so being able to read that mail is the difference between testing the
# feature and testing everything around it. Read it at http://127.0.0.1:8025.
MAILER_DSN=smtp://127.0.0.1:${MAILPIT_SMTP_PORT:-1025}
