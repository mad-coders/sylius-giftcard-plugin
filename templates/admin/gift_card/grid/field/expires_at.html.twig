{% if data.expiresAt is null %}
    <span class="text-secondary">{{ 'madcoders_sylius_gift_card.ui.never_expires'|trans }}</span>
{% elseif data.isExpired() %}
    <span class="text-danger" {{ sylius_test_html_attribute('gift-card-expired') }}>
        {{ data.expiresAt|date('d-m-Y') }}
    </span>
{% else %}
    {{ data.expiresAt|date('d-m-Y') }}
{% endif %}
