{# Every card expires - see docs/adr-log/0015-every-gift-card-expires.md - so the only question
   left is whether it already has. #}
{% if data.isExpired() %}
    <span class="text-danger" {{ sylius_test_html_attribute('gift-card-expired') }}>
        {{ data.expiresAt|date('d-m-Y') }}
    </span>
{% else %}
    {{ data.expiresAt|date('d-m-Y') }}
{% endif %}
