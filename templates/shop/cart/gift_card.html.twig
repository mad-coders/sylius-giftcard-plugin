{#
    The gift card panel on the cart page.

    Rendered outside Sylius' cart <form> on purpose - see config/twig_hooks/shop.yaml. The panel
    itself lives in a shared partial, because the checkout sidebar carries the same one.
#}
{% set cart = hookable_metadata.context.cart|default(null) %}

{% if cart is not null and not cart.empty %}
    <div class="mb-4" {{ sylius_test_html_attribute('gift-card-panel') }}>
        <div class="p-4 bg-light">
            <h5 class="mb-3">{{ 'madcoders_sylius_gift_card.ui.gift_cards'|trans }}</h5>

            {% include '@MadcodersSyliusGiftCardPlugin/shop/common/gift_card_panel.html.twig' with {
                'order': cart,
                'return_to': 'cart',
                'compact': false,
            } only %}
        </div>
    </div>
{% endif %}
