{#
    Sent when an order containing gift cards is paid.

    Extends Sylius' email layout so it inherits the shop's branding, and keeps its own markup plain
    and table-free so it survives the mail clients that rewrite layout. A host application restyles
    it by overriding this one template.
#}
{% extends '@SyliusCore/Email/layout.html.twig' %}

{% block subject %}
    {{ 'madcoders_sylius_gift_card.emails.gift_cards_purchased.subject'|trans({}, 'messages', localeCode) }}
{% endblock %}

{% block content %}
    <h1>{{ 'madcoders_sylius_gift_card.emails.gift_cards_purchased.heading'|trans({}, 'messages', localeCode) }}</h1>

    <p>{{ 'madcoders_sylius_gift_card.emails.gift_cards_purchased.intro'|trans({}, 'messages', localeCode) }}</p>

    {% for gift_card in giftCards %}
        <p style="margin: 1.5em 0;">
            <strong style="font-size: 1.25em; letter-spacing: 0.1em;">{{ gift_card.code }}</strong><br>
            {{ 'madcoders_sylius_gift_card.ui.initial_amount'|trans({}, 'messages', localeCode) }}:
            {{ gift_card.initialAmount|default(0)|sylius_format_money(gift_card.currencyCode|default('USD'), localeCode) }}

            {% if gift_card.expiresAt is not null %}
                <br>
                {{ 'madcoders_sylius_gift_card.ui.expires_at'|trans({}, 'messages', localeCode) }}:
                {{ gift_card.expiresAt|date('d-m-Y') }}
            {% endif %}
        </p>
    {% endfor %}

    <p>{{ 'madcoders_sylius_gift_card.emails.gift_cards_purchased.how_to_use'|trans({}, 'messages', localeCode) }}</p>
{% endblock %}
