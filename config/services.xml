<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <!-- Services are declared per concern under config/services/ - see docs/adr-log/0003-service-wiring.md. -->
    <imports>
        <import resource="services/*.xml" />
    </imports>

    <parameters>
        <!-- The role required for gift card admin actions that move money. A host with a finer
             permission model can override this parameter. -->
        <parameter key="madcoders_sylius_gift_card.admin_role">ROLE_ADMINISTRATION_ACCESS</parameter>
    </parameters>

</container>
