<?xml version="1.0" encoding="UTF-8" ?>

<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping
                                        https://symfony.com/schema/dic/constraint-mapping/constraint-mapping-1.0.xsd">

    <!--
        A channel has to say how long its cards last, and has to say it in words the plugin can act
        on. Before this, a blank period issued cards that never expired and a mistyped one ("1 yaer")
        did the same thing silently - the operator walked away believing they had configured
        something. See docs/adr-log/0015-every-gift-card-expires.md.

        On the model rather than on the form fields, so a configuration written by an importer or a
        data fixture is judged by the same rules as one typed into the admin.

        Both groups are listed on purpose - see the note in GiftCard.xml.
    -->
    <class name="Madcoders\SyliusGiftCardPlugin\Model\GiftCardConfiguration">
        <property name="validityPeriod">
            <constraint name="NotBlank">
                <option name="message">madcoders_sylius_gift_card.gift_card_configuration.validity_period.not_blank</option>
                <option name="groups">
                    <value>Default</value>
                    <value>madcoders_sylius_gift_card</value>
                </option>
            </constraint>
            <constraint name="Madcoders\SyliusGiftCardPlugin\Validator\Constraints\ValidityPeriod">
                <option name="groups">
                    <value>Default</value>
                    <value>madcoders_sylius_gift_card</value>
                </option>
            </constraint>
        </property>
    </class>

</constraint-mapping>
