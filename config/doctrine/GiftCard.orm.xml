<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <mapped-superclass name="Madcoders\SyliusGiftCardPlugin\Model\GiftCard" table="madcoders_gift_card__gift_card">
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="code" column="code" type="string" length="64" unique="true" />
        <field name="currencyCode" column="currency_code" type="string" length="3" nullable="true" />
        <field name="initialAmount" column="initial_amount" type="integer" nullable="true" />
        <field name="amount" column="amount" type="integer" />
        <field name="enabled" column="enabled" type="boolean" />
        <field name="expiresAt" column="expires_at" type="datetime" nullable="true" />
        <field name="origin" column="origin" type="string" length="16" enum-type="Madcoders\SyliusGiftCardPlugin\Model\GiftCardOrigin" />
        <field name="customMessage" column="custom_message" type="text" nullable="true" />
        <field name="createdAt" column="created_at" type="datetime" nullable="true" />
        <field name="updatedAt" column="updated_at" type="datetime" nullable="true" />

        <many-to-one field="channel" target-entity="Sylius\Component\Core\Model\ChannelInterface">
            <join-column name="channel_id" referenced-column-name="id" nullable="true" on-delete="SET NULL" />
        </many-to-one>

        <!-- The customer who bought the card. -->
        <many-to-one field="purchaser" target-entity="Sylius\Component\Core\Model\CustomerInterface">
            <join-column name="purchaser_id" referenced-column-name="id" nullable="true" on-delete="SET NULL" />
        </many-to-one>

        <!-- The customer who redeems the card; assigned once, on first redemption. -->
        <many-to-one field="redeemer" target-entity="Sylius\Component\Core\Model\CustomerInterface">
            <join-column name="redeemer_id" referenced-column-name="id" nullable="true" on-delete="SET NULL" />
        </many-to-one>

        <!--
            The purchased unit this card was generated for. Owning side; the inverse side lives on
            the host application's OrderItemUnit through OrderItemUnitTrait.
        -->
        <one-to-one field="orderItemUnit" target-entity="Madcoders\SyliusGiftCardPlugin\Model\OrderItemUnitInterface" inversed-by="giftCard">
            <join-column name="order_item_unit_id" referenced-column-name="id" nullable="true" unique="true" on-delete="SET NULL" />
        </one-to-one>

        <!--
            Inverse side. The owning side (and therefore the join table) is declared on the host
            application's Order through OrderTrait.
        -->
        <many-to-many field="appliedOrders" target-entity="Sylius\Component\Core\Model\OrderInterface" mapped-by="giftCards" />

        <one-to-many field="transactions" target-entity="Madcoders\SyliusGiftCardPlugin\Model\GiftCardTransactionInterface" mapped-by="giftCard" orphan-removal="true">
            <order-by>
                <order-by-field name="id" direction="ASC" />
            </order-by>

            <cascade>
                <cascade-all />
            </cascade>
        </one-to-many>
    </mapped-superclass>

</doctrine-mapping>
