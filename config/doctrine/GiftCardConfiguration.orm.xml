<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <mapped-superclass name="Madcoders\SyliusGiftCardPlugin\Model\GiftCardConfiguration" table="madcoders_gift_card__configuration">
        <id name="id" column="id" type="integer">
            <generator strategy="AUTO" />
        </id>

        <field name="codeLength" column="code_length" type="integer" />
        <field name="codePrefix" column="code_prefix" type="string" length="16" nullable="true" />
        <field name="validityPeriod" column="validity_period" type="string" length="64" nullable="true" />
        <!-- The default matches the migration, so a host is left in sync per doctrine:schema:validate. -->
        <field name="saleMode" column="sale_mode" type="string" length="16" enum-type="Madcoders\SyliusGiftCardPlugin\Model\GiftCardSaleMode">
            <options>
                <option name="default">sellable</option>
            </options>
        </field>
        <!--
            The default is declared here as well as in the migration: the column is added to a table
            that already has rows, so it needs one, and `doctrine:schema:validate` compares the two.
        -->
        <field name="amountMode" column="amount_mode" type="string" length="32" enum-type="Madcoders\SyliusGiftCardPlugin\Model\GiftCardAmountMode">
            <options>
                <option name="default">fixed</option>
            </options>
        </field>
        <!--
            A short, ordered list of amounts in minor units; JSON keeps it one column and one read.
            Nullable because MySQL refuses a default on a JSON column, and a column added to an
            existing table needs one - null and [] both mean "no presets", which the model resolves.
        -->
        <field name="amountPresets" column="amount_presets" type="json" nullable="true" />
        <field name="minimumAmount" column="minimum_amount" type="integer" nullable="true" />
        <field name="maximumAmount" column="maximum_amount" type="integer" nullable="true" />
        <field name="enabled" column="enabled" type="boolean" />
        <field name="createdAt" column="created_at" type="datetime" nullable="true" />
        <field name="updatedAt" column="updated_at" type="datetime" nullable="true" />

        <!-- At most one configuration per channel. -->
        <one-to-one field="channel" target-entity="Sylius\Component\Core\Model\ChannelInterface">
            <join-column name="channel_id" referenced-column-name="id" nullable="false" unique="true" on-delete="CASCADE" />
        </one-to-one>
    </mapped-superclass>

</doctrine-mapping>
