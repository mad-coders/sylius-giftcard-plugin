<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="madcoders_sylius_gift_card.fixture.example_factory.gift_card"
                 class="Madcoders\SyliusGiftCardPlugin\Fixture\Factory\GiftCardExampleFactory">
            <argument type="service" id="madcoders_sylius_gift_card.factory.gift_card" />
            <argument type="service" id="sylius.repository.channel" />
            <argument type="service" id="sylius.repository.customer" />
            <argument type="service" id="madcoders_sylius_gift_card.generator.gift_card_code" />
            <argument type="service" id="madcoders_sylius_gift_card.provider.gift_card_configuration" />
            <argument type="service" id="madcoders_sylius_gift_card.modifier.gift_card_balance" />
        </service>

        <service id="madcoders_sylius_gift_card.fixture.gift_card"
                 class="Madcoders\SyliusGiftCardPlugin\Fixture\GiftCardFixture">
            <argument type="service" id="doctrine.orm.entity_manager" />
            <argument type="service" id="madcoders_sylius_gift_card.fixture.example_factory.gift_card" />
            <tag name="sylius_fixtures.fixture" />
        </service>

        <service id="madcoders_sylius_gift_card.fixture.gift_card_product"
                 class="Madcoders\SyliusGiftCardPlugin\Fixture\GiftCardProductFixture">
            <argument type="service" id="sylius.repository.product" />
            <argument type="service" id="doctrine.orm.entity_manager" />
            <tag name="sylius_fixtures.fixture" />
        </service>

        <service id="madcoders_sylius_gift_card.fixture.example_factory.gift_card_configuration"
                 class="Madcoders\SyliusGiftCardPlugin\Fixture\Factory\GiftCardConfigurationExampleFactory">
            <argument type="service" id="madcoders_sylius_gift_card.factory.gift_card_configuration" />
            <argument type="service" id="sylius.repository.channel" />
        </service>

        <service id="madcoders_sylius_gift_card.fixture.gift_card_configuration"
                 class="Madcoders\SyliusGiftCardPlugin\Fixture\GiftCardConfigurationFixture">
            <argument type="service" id="doctrine.orm.entity_manager" />
            <argument type="service" id="madcoders_sylius_gift_card.fixture.example_factory.gift_card_configuration" />
            <tag name="sylius_fixtures.fixture" />
        </service>
    </services>

</container>
