<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <!--
            The alias in `validatedBy()` is what the validator factory looks up, so the tag has to
            carry it - the class name alone would not be found.
        -->
        <service id="madcoders_sylius_gift_card.validator.gift_card_purchase_allowed"
                 class="Madcoders\SyliusGiftCardPlugin\Validator\Constraints\GiftCardPurchaseAllowedValidator">
            <argument type="service" id="madcoders_sylius_gift_card.checker.gift_card_purchase" />
            <tag name="validator.constraint_validator" alias="madcoders_sylius_gift_card_purchase_allowed" />
        </service>

        <service id="madcoders_sylius_gift_card.validator.order_gift_card_purchase_allowed"
                 class="Madcoders\SyliusGiftCardPlugin\Validator\Constraints\OrderGiftCardPurchaseAllowedValidator">
            <argument type="service" id="madcoders_sylius_gift_card.checker.gift_card_purchase" />
            <tag name="validator.constraint_validator" alias="madcoders_sylius_gift_card_order_purchase_allowed" />
        </service>

        <service id="madcoders_sylius_gift_card.validator.gift_card_redemption_allowed"
                 class="Madcoders\SyliusGiftCardPlugin\Validator\Constraints\GiftCardRedemptionAllowedValidator">
            <argument type="service" id="madcoders_sylius_gift_card.checker.gift_card_tender" />
            <tag name="validator.constraint_validator" alias="madcoders_sylius_gift_card_redemption_allowed" />
        </service>

        <!-- Refuses a channel validity period that cannot produce a future expiry date. -->
        <service id="madcoders_sylius_gift_card.validator.validity_period"
                 class="Madcoders\SyliusGiftCardPlugin\Validator\Constraints\ValidityPeriodValidator">
            <argument type="service" id="madcoders_sylius_gift_card.calculator.gift_card_expiry" />
            <tag name="validator.constraint_validator" alias="madcoders_sylius_gift_card_validity_period" />
        </service>

        <!--
            Refuses an amount the channel does not offer, and says which of the two reasons it is so
            the customer is told the bounds rather than just "invalid".

            No `alias` on the tag, unlike the two above: this constraint does not override
            validatedBy(), so the factory looks the validator up by its class name - which is what
            the tag registers when no alias is given.
        -->
        <service id="madcoders_sylius_gift_card.validator.chosen_gift_card_amount"
                 class="Madcoders\SyliusGiftCardPlugin\Validator\Constraints\ChosenGiftCardAmountValidator">
            <argument type="service" id="sylius.context.channel" />
            <argument type="service" id="sylius.context.locale" />
            <argument type="service" id="madcoders_sylius_gift_card.provider.gift_card_configuration" />
            <argument type="service" id="sylius.formatter.money" />
            <tag name="validator.constraint_validator" />
        </service>
    </services>

</container>
