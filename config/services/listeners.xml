<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <!--
            Symfony Workflow listeners. Sylius 2.x defaults to that adapter and does not install
            winzou/state-machine at all - it is only a `suggest` - so there is one wiring here
            rather than two, and it is the one CI exercises.
        -->
        <service id="madcoders_sylius_gift_card.listener.workflow.order.debit_gift_cards"
                 class="Madcoders\SyliusGiftCardPlugin\EventListener\Workflow\Order\DebitGiftCardsListener">
            <argument type="service" id="madcoders_sylius_gift_card.modifier.order_gift_card_amount" />
            <tag name="kernel.event_listener" event="workflow.sylius_order.completed.create" />
        </service>

        <service id="madcoders_sylius_gift_card.listener.workflow.order.credit_gift_cards"
                 class="Madcoders\SyliusGiftCardPlugin\EventListener\Workflow\Order\CreditGiftCardsListener">
            <argument type="service" id="madcoders_sylius_gift_card.modifier.order_gift_card_amount" />
            <tag name="kernel.event_listener" event="workflow.sylius_order.completed.cancel" />
        </service>

        <service id="madcoders_sylius_gift_card.listener.workflow.order_payment.issue_gift_cards"
                 class="Madcoders\SyliusGiftCardPlugin\EventListener\Workflow\OrderPayment\IssueGiftCardsListener">
            <argument type="service" id="madcoders_sylius_gift_card.operator.order_gift_card" />
            <tag name="kernel.event_listener" event="workflow.sylius_order_payment.completed.pay" />
        </service>

        <!-- Runs after the issuing listener, so the email has codes to carry. -->
        <service id="madcoders_sylius_gift_card.listener.workflow.order_payment.send_gift_cards"
                 class="Madcoders\SyliusGiftCardPlugin\EventListener\Workflow\OrderPayment\SendGiftCardsListener">
            <argument type="service" id="madcoders_sylius_gift_card.mailer.gift_card_email_sender" />
            <tag name="kernel.event_listener" event="workflow.sylius_order_payment.completed.pay" priority="-100" />
        </service>

        <service id="madcoders_sylius_gift_card.listener.workflow.order.disable_bought_gift_cards"
                 class="Madcoders\SyliusGiftCardPlugin\EventListener\Workflow\Order\DisableBoughtGiftCardsListener">
            <argument type="service" id="madcoders_sylius_gift_card.operator.order_gift_card" />
            <tag name="kernel.event_listener" event="workflow.sylius_order.completed.cancel" />
        </service>
    </services>

</container>
