<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <!--
            Priority 45 puts this immediately BELOW Sylius' price recalculator (50), which resets
            every item's unit price from channel pricing, and ABOVE promotions (20), taxes (10) and
            the payment (0). So a customer-chosen amount survives recalculation and is the base all
            three of those work from - see
            docs/adr-log/0014-customer-chosen-gift-card-amount.md.
        -->
        <service id="madcoders_sylius_gift_card.order_processing.gift_card_chosen_amount_processor"
                 class="Madcoders\SyliusGiftCardPlugin\OrderProcessor\GiftCardChosenAmountProcessor">
            <argument type="service" id="madcoders_sylius_gift_card.provider.gift_card_configuration" />
            <tag name="sylius.order_processor" priority="45" />
        </service>

<!--
            Priority -10 puts this BELOW Sylius' payment processor (0), which is deliberate: that
            processor sets the payment from the order total, and this one then takes what the gift
            cards cover off the payment. A gift card is money against the amount to pay, not a
            discount on the price, so the order total is left alone - see
            docs/adr-log/0010-gift-card-as-tender.md.

            It still runs after taxes (10), so what the cards settle against is the real amount
            owed. Its adjustments are neutral and are cleared at the start of the next run by
            RegisterGiftCardAdjustmentClearingPass, which keeps processing idempotent.
        -->
        <service id="madcoders_sylius_gift_card.order_processing.order_gift_card_processor"
                 class="Madcoders\SyliusGiftCardPlugin\OrderProcessor\OrderGiftCardProcessor">
            <argument type="service" id="sylius.factory.adjustment" />
            <argument type="service" id="translator" />
            <argument type="service" id="madcoders_sylius_gift_card.checker.gift_card_tender" />
            <tag name="sylius.order_processor" priority="-10" />
        </service>

        <!--
            When a payment fails or is cancelled, Sylius replaces it with one for the full order
            total. The cards were debited when the order was placed, so without this the customer
            would be asked to pay that money a second time. The processor above cannot help: it only
            runs while the order is a cart.
        -->
        <service id="madcoders_sylius_gift_card.order_processing.retry_payment_processor"
                 class="Madcoders\SyliusGiftCardPlugin\OrderProcessor\GiftCardAwareRetryPaymentProcessor"
                 decorates="sylius.order_processing.order_payment_processor.after_checkout">
            <argument type="service" id="madcoders_sylius_gift_card.order_processing.retry_payment_processor.inner" />
        </service>

        <!--
            The single write path for a gift card balance: it moves the amount and records the
            ledger entry together, so no caller can change one without the other.
        -->
        <service id="madcoders_sylius_gift_card.modifier.gift_card_balance"
                 class="Madcoders\SyliusGiftCardPlugin\Modifier\GiftCardBalanceModifier">
            <argument type="service" id="madcoders_sylius_gift_card.factory.gift_card_transaction" />
        </service>

        <service id="Madcoders\SyliusGiftCardPlugin\Modifier\GiftCardBalanceModifierInterface"
                 alias="madcoders_sylius_gift_card.modifier.gift_card_balance" />

        <service id="madcoders_sylius_gift_card.modifier.order_gift_card_amount"
                 class="Madcoders\SyliusGiftCardPlugin\Modifier\OrderGiftCardAmountModifier"
                 public="true">
            <argument type="service" id="madcoders_sylius_gift_card.modifier.gift_card_balance" />
        </service>

        <service id="Madcoders\SyliusGiftCardPlugin\Modifier\OrderGiftCardAmountModifierInterface"
                 alias="madcoders_sylius_gift_card.modifier.order_gift_card_amount" />

        <!-- Gift cards bought on an order, as opposed to spent on one. -->
        <service id="madcoders_sylius_gift_card.operator.order_gift_card"
                 class="Madcoders\SyliusGiftCardPlugin\Operator\OrderGiftCardOperator"
                 public="true">
            <argument type="service" id="madcoders_sylius_gift_card.factory.gift_card" />
            <argument type="service" id="madcoders_sylius_gift_card.generator.gift_card_code" />
            <argument type="service" id="madcoders_sylius_gift_card.provider.gift_card_configuration" />
            <argument type="service" id="madcoders_sylius_gift_card.manager.gift_card" />
            <argument type="service" id="madcoders_sylius_gift_card.checker.gift_card_purchase" />
            <!-- Optional: a host can run without MonologBundle, which is what defines `logger`. -->
            <argument type="service" id="logger" on-invalid="null" />
        </service>

        <service id="Madcoders\SyliusGiftCardPlugin\Operator\OrderGiftCardOperatorInterface"
                 alias="madcoders_sylius_gift_card.operator.order_gift_card" />

        <service id="madcoders_sylius_gift_card.mailer.gift_card_email_sender"
                 class="Madcoders\SyliusGiftCardPlugin\Mailer\GiftCardEmailSender"
                 public="true">
            <argument type="service" id="sylius.email_sender" />
            <argument type="service" id="madcoders_sylius_gift_card.operator.order_gift_card" />
        </service>

        <service id="Madcoders\SyliusGiftCardPlugin\Mailer\GiftCardEmailSenderInterface"
                 alias="madcoders_sylius_gift_card.mailer.gift_card_email_sender" />

        <service id="Madcoders\SyliusGiftCardPlugin\OrderProcessor\OrderGiftCardProcessor"
                 alias="madcoders_sylius_gift_card.order_processing.order_gift_card_processor" />
    </services>

</container>
