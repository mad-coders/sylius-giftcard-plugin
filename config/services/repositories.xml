<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <!--
            Interface-named aliases for the repositories Sylius generates from config/resources.yaml,
            so host code can autowire the plugin's contracts instead of referencing service ids.
        -->
        <service id="Madcoders\SyliusGiftCardPlugin\Repository\GiftCardRepositoryInterface"
                 alias="madcoders_sylius_gift_card.repository.gift_card" />

        <service id="Madcoders\SyliusGiftCardPlugin\Repository\GiftCardConfigurationRepositoryInterface"
                 alias="madcoders_sylius_gift_card.repository.gift_card_configuration" />
    </services>

</container>
