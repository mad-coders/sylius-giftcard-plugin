<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="madcoders_sylius_gift_card.form.type.gift_card_code"
                 class="Madcoders\SyliusGiftCardPlugin\Form\Type\GiftCardCodeType">
            <tag name="form.type" />
        </service>

        <!--
            Both groups, and the order does not matter - see docs/adr-log/0017-resource-forms-validate-with-default-too.md.

            `madcoders_sylius_gift_card` alone is what issue #44 was: Symfony's FormValidator only
            evaluates a constraint whose groups intersect the form's, so every constraint the plugin
            declares in `Default` - the inline ones on the fields, and the UniqueEntity on the model -
            was skipped in silence. Adding `Default` makes them run without taking the resource group
            away from a host that has declared constraints in it.

            A constraint listed in both groups is still evaluated once: Symfony deduplicates
            constraints that belong to more than one of the groups being validated.
        -->
        <service id="madcoders_sylius_gift_card.form.type.gift_card"
                 class="Madcoders\SyliusGiftCardPlugin\Form\Type\GiftCardType">
            <argument>%madcoders_sylius_gift_card.model.gift_card.class%</argument>
            <argument type="collection">
                <argument>madcoders_sylius_gift_card</argument>
                <argument>Default</argument>
            </argument>
            <!-- Pre-fills the expiry field, so the administrator sees the date they are issuing. -->
            <argument type="service" id="madcoders_sylius_gift_card.calculator.gift_card_expiry" />
            <argument type="service" id="madcoders_sylius_gift_card.provider.gift_card_configuration" />
            <argument type="service" id="sylius.repository.channel" />
            <tag name="form.type" />
        </service>

        <!-- The same reconciliation, for the same reason: this form had the same mismatch. -->
        <service id="madcoders_sylius_gift_card.form.type.gift_card_configuration"
                 class="Madcoders\SyliusGiftCardPlugin\Form\Type\GiftCardConfigurationType">
            <argument>%madcoders_sylius_gift_card.model.gift_card_configuration.class%</argument>
            <argument type="collection">
                <argument>madcoders_sylius_gift_card</argument>
                <argument>Default</argument>
            </argument>
            <argument type="service" id="translator" />
            <tag name="form.type" />
        </service>

        <service id="madcoders_sylius_gift_card.form.type.adjust_balance"
                 class="Madcoders\SyliusGiftCardPlugin\Form\Type\GiftCardAdjustBalanceType">
            <tag name="form.type" />
        </service>

        <service id="madcoders_sylius_gift_card.form.extension.type.product"
                 class="Madcoders\SyliusGiftCardPlugin\Form\Extension\ProductTypeExtension">
            <tag name="form.type_extension" extended-type="Sylius\Bundle\ProductBundle\Form\Type\ProductType" />
        </service>

        <!-- What the customer wants the card to be worth, and what they want it to say. -->
        <service id="madcoders_sylius_gift_card.form.type.gift_card_amount"
                 class="Madcoders\SyliusGiftCardPlugin\Form\Type\GiftCardAmountType">
            <argument type="service" id="sylius.formatter.money" />
            <tag name="form.type" />
        </service>

        <!--
            Extends the base cart item type, so both Sylius' shop and core add-to-cart forms carry
            the fields. They are only added for a gift card product, so every other product's form
            is untouched.
        -->
        <service id="madcoders_sylius_gift_card.form.extension.type.cart_item"
                 class="Madcoders\SyliusGiftCardPlugin\Form\Extension\CartItemTypeExtension">
            <argument type="service" id="sylius.context.channel" />
            <argument type="service" id="sylius.context.locale" />
            <argument type="service" id="madcoders_sylius_gift_card.provider.gift_card_configuration" />
            <tag name="form.type_extension" extended-type="Sylius\Bundle\OrderBundle\Form\Type\CartItemType" />
        </service>
    </services>

</container>
